{
  "name": "store-ratings-server",
  "version": "1.0.0",
  "description": "Express + PostgreSQL API for the Store Ratings Platform",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node migrations/run.js && node migrations/seed.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node migrations/run.js",
    "seed": "node migrations/seed.js",
    "reset-db": "node migrations/reset.js",
    "format": "prettier --write \"src/**/*.js\" \"migrations/**/*.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
